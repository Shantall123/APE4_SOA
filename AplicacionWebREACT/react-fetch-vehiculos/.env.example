# Configuración local del proxy de Vite (copiar como .env.local; *.local NO se sube a Git).
# Estas variables NO llevan el prefijo VITE_: Vite no las incluye en el código del navegador.
API_BASE_URL=http://127.0.0.1:8090
OAUTH_CLIENT_ID=vehiculos-client
OAUTH_CLIENT_SECRET=REEMPLAZAR_POR_app.security.client-secret
