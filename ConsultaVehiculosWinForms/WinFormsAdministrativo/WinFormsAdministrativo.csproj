<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>WinFormsAdministrativo</RootNamespace>
    <!-- Escalado nítido en pantallas de alta resolución y fuente uniforme. -->
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationDefaultFont>Segoe UI, 9.75pt</ApplicationDefaultFont>
  </PropertyGroup>

  <ItemGroup>
    <!-- Configuración local (URL de NGINX y credenciales del cliente).
         appsettings.json NO se sube a Git; se publica appsettings.example.json. -->
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="appsettings.example.json" CopyToOutputDirectory="Never" />
  </ItemGroup>

</Project>
