# Configuración local del servidor de la PWA (copiar como .env; .env NO se sube a Git)
# NGINX: puerta de entrada a la API Java (8080/8083) y a FastAPI (8000)
API_BASE_URL=http://127.0.0.1:8090
# Credenciales del CLIENTE OAuth (app.security.client-id / client-secret de la API Java).
# Se usan solo en el servidor; el navegador nunca las recibe.
OAUTH_CLIENT_ID=vehiculos-client
OAUTH_CLIENT_SECRET=REEMPLAZAR_POR_app.security.client-secret
# Puerto de la PWA (React usa 5173)
PORT=5174
HOST=127.0.0.1
