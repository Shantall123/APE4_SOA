# Copie este archivo como .env y reemplace los valores COLOCA_...
# (.env está excluido de Git; nunca suba credenciales reales).

#conexion a la bd
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=venta_vehiculos
DB_USER=COLOCA_USUARIO_MYSQL
DB_PASSWORD=

#URL API DE JAVA (a traves de NGINX)
JAVA_URL=http://127.0.0.1:8090
VENTAS_SERVICE_KEY=COLOCA_CLAVE_DE_SERVICIO_DE_32_CARACTERES_O_MAS

#RABBITMQ (Actividad 8): la venta confirmada se publica en una cola durable
# guest solo para desarrollo local; %2F es el vhost "/"
RABBITMQ_URL=amqp://guest:guest@127.0.0.1:5672/%2F
RABBITMQ_EXCHANGE=ventas.eventos
RABBITMQ_COLA=notificaciones.ventas
RABBITMQ_ROUTING_KEY=venta.completada
